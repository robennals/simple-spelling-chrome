{
  "manifest_version": 3,
  "name": "Simple Spelling",
  "version": "0.1.0",
  "description": "Read the web in simpler, more phonetic English spelling: tho, thru, nite, luv, hed, skool. One switch turns it on or off.",
  "minimum_chrome_version": "93",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Simple Spelling",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["respell.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["respellings.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
